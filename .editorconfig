root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
# Disable function naming rule for Compose (Composables use PascalCase)
ktlint_standard_function-naming = disabled
# Disable class naming for migration classes that use underscores
ktlint_standard_class-naming = disabled
# Disable filename rule as it's too strict for multi-declaration files
ktlint_standard_filename = disabled

# Compose-specific rules - disable overly strict ones
ktlint_compose_modifier-missing-check = disabled
ktlint_compose_param-order-check = disabled
ktlint_compose_vm-forwarding-check = disabled
ktlint_compose_lambda-param-in-effect = disabled
ktlint_compose_lambda-param-event-trailing = disabled
ktlint_compose_multiple-emitters-check = disabled
ktlint_compose_modifier-reused-check = disabled
ktlint_compose_modifier-not-used-at-root = disabled
ktlint_compose_parameter-naming = disabled
